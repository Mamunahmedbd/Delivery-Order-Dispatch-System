NODE_ENV=development

#== APP
PORT=3000
TRANSPORT_PORT=8080
JWT_EXPIRATION_TIME=86400
FALLBACK_LANGUAGE=en_US
ENABLE_ORM_LOGS=true
ENABLE_DOCUMENTATION=true
API_VERSION=v1.0.0

#== JWT Auth
JWT_PRIVATE_KEY=your-rsa-private-key
JWT_PUBLIC_KEY=your-rsa-public-key

#== DB
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=delivery_dev

#== AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_BUCKET_REGION=eu-central-1
AWS_S3_API_VERSION=2006-03-01

#== NATS
NATS_ENABLED=false
NATS_HOST=localhost
NATS_PORT=4222

#== Redis (required for BullMQ queues)
REDIS_URL=redis://localhost:6379

#== Throttler
THROTTLER_TTL=1m
THROTTLER_LIMIT=10

#== Delivery System Config
DRIVER_ASSIGNMENT_TIMEOUT_MS=60000
MAX_ASSIGNMENT_ATTEMPTS=3
WEBHOOK_SECRET=your-hmac-secret-change-in-production